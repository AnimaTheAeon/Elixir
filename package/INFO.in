package="Elixir"
version="@VERSION@"
os_min_ver="7.0-41890"
displayname="Elixir"
description="Renames TV shows, movies and anime using TheMovieDB, TheTVDB and AniDB. Works with Lifestream, Midgar and Turks: what they download, they keep; Elixir names the rest. Automatic renaming is optional and starts off."
